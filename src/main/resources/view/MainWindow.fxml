<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="600.0" prefWidth="500.0" stylesheets="@../css/main.css"
        xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="james.gui.MainWindow">
    <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type your command here."
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="80.0" />
    <Button onAction="#handleUserInput" text="Send" AnchorPane.bottomAnchor="0.0"
            AnchorPane.rightAnchor="0.0" />
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
            AnchorPane.bottomAnchor="42.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content><VBox fx:id="dialogContainer" spacing="4.0" /></content>
    </ScrollPane>
</AnchorPane>
