<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="600.0" prefWidth="500.0" stylesheets="@../css/main.css"
        xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="james.gui.MainWindow">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                minHeight="0.0" VBox.vgrow="ALWAYS">
            <content><VBox fx:id="dialogContainer" spacing="4.0" /></content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0" /></padding>
            <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type your command here."
                    minWidth="0.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" onAction="#handleUserInput" text="Send"
                    minWidth="72.0" maxHeight="Infinity" />
        </HBox>
    </VBox>
</AnchorPane>
